DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/kitaly?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-your-password-hash
ADMIN_URL_PREFIX=admin
UPLOAD_FOLDER=uploads
PORT=5001

# Daily local backups: retain up to 30 days within 3 GiB, newest always kept.
# Reserve 2 GiB for live uploads and database writes; skip backup if too tight.
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_BYTES=3221225472
BACKUP_MIN_FREE_BYTES=2147483648

# Start disabled. Configure and test before changing this to true.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:5001
# Enable additional destinations after setting weights and confirming fulfilment.
STRIPE_SHIPPING_COUNTRIES=GB
# The Royal Mail tariff is in GBP. Set false only to retain legacy flat rates.
ROYAL_MAIL_CHECKOUT=true
# Only used when ROYAL_MAIL_CHECKOUT=false.
STRIPE_SHIPPING_RATES={"GBP":650}
# Weigh items in admin and supply the exact standard packaging allowance in grams
# before enabling international countries. Leave blank to require a quote.
SHIPPING_PACKAGING_GRAMS=

# Customer dispatch emails: Outlook.com requires OAuth, not a mailbox password.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=kitaly.official@outlook.com
SMTP_FROM=kitaly.official@outlook.com
# For other SMTP providers only; never commit an actual password.
SMTP_PASSWORD=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_TENANT=consumers
# Owner-only JSON token file outside the repository (refresh_token/access_token/expires_at).
SMTP_OAUTH_TOKEN_FILE=

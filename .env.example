DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/kitaly?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-your-password-hash
ADMIN_URL_PREFIX=admin
UPLOAD_FOLDER=uploads
PORT=5001

# Start disabled. Configure and test before changing this to true.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:5001
# Explicit delivery destinations (ISO country codes), e.g. GB,IT,CH.
STRIPE_SHIPPING_COUNTRIES=
# Fixed delivery fee per supported product currency, in minor units.
# Example only: {"GBP":500,"EUR":600}. Use 0 explicitly for free delivery.
STRIPE_SHIPPING_RATES={}

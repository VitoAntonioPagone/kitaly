DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/kitaly?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-your-password-hash
ADMIN_URL_PREFIX=admin
UPLOAD_FOLDER=uploads
PORT=5001

# Start disabled. Configure and test before changing this to true.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:5001
# Current delivery policy: United Kingdom only (ISO country code GB).
STRIPE_SHIPPING_COUNTRIES=GB
# Fixed delivery fee per supported product currency, in minor units.
# Agreed UK delivery fee: GBP 6.50 per single-item order.
STRIPE_SHIPPING_RATES={"GBP":650}

# Customer dispatch emails: Outlook.com requires OAuth, not a mailbox password.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=kitaly.official@outlook.com
SMTP_FROM=kitaly.official@outlook.com
# For other SMTP providers only; never commit an actual password.
SMTP_PASSWORD=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_TENANT=consumers
# Owner-only JSON token file outside the repository (refresh_token/access_token/expires_at).
SMTP_OAUTH_TOKEN_FILE=
